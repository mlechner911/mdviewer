{
  "name": "mlc-markdown",
  "version": "0.1.0",
  "description": "Rendering of Markdown with the MLC Markdown Extension (non-standard): form fields, fill hints, alerts, anchors, page breaks — the same look in MarkSafe, the MLC Sensor Monitor and the MLC Terminal. Display only; the rules live in the Go module mlcext.",
  "keywords": [
    "markdown",
    "marked",
    "mlc",
    "forms",
    "sop",
    "renderer"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles/mlc-markdown.css"
  },
  "files": [
    "dist",
    "styles",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlechner911/mdviewer",
    "directory": "packages/mlc-markdown"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "dompurify": "^3.4.0",
    "marked": "^18.0.0",
    "marked-footnote": "^1.4.0"
  },
  "devDependencies": {
    "jsdom": "^26.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "homepage": "https://github.com/mlechner911/mdviewer/blob/main/docs/MLC-EXTENSIONS.md",
  "bugs": {
    "url": "https://github.com/mlechner911/mdviewer/issues"
  },
  "author": "Michael Lechner",
  "publishConfig": {
    "access": "public"
  }
}
