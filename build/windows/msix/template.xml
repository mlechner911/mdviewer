<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="marksafe"
        Arguments=""
        InstallLocation="C:\Program Files\Michael Lechner\MarkSafe">
    </Installer>
    <PackageInformation
        PackageName="MarkSafe"
        PackageDisplayName="MarkSafe"
        PublisherName="CN=Michael Lechner"
        PublisherDisplayName="Michael Lechner"
        Version="1.5.0.0"
        PackageDescription="Markdown viewer and editor">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="eu.mlcgo.marksafe"
                Description="Markdown viewer and editor"
                DisplayName="MarkSafe"
                ExecutableName="marksafe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>MarkSafe</DisplayName>
            <PublisherDisplayName>Michael Lechner</PublisherDisplayName>
            <Description>Markdown viewer and editor</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="marksafe.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
