# MarkSafe with an optional module (SENSOR=1, see Taskfile.yml) installs as
# "MarkSafePlus" (INFO_PRODUCTNAME) and ships the module's license, the
# Elastic License 2.0, as licenses\LICENSE-sensormonitor. The standard
# installer defines neither. Kept in its own file: project.nsi can be
# regenerated by wails3.

!macro marksafe.moduleLicense
    !ifdef ARG_MODULE_LICENSE
        SetOutPath "$INSTDIR\licenses"
        File "/oname=LICENSE-sensormonitor" "${ARG_MODULE_LICENSE}"
        SetOutPath $INSTDIR
    !endif
!macroend
