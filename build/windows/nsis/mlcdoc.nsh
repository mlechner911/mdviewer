# MarkSafe ships the MLC PDF toolkit mlcdoc next to marksafe.exe (PDF
# preview and export find it there). ARG_MLCDOC_DIR is the folder with
# mlcdoc.exe and its licenses, prepared by the root task `mlcdoc:fetch`.
# Kept in its own file: project.nsi can be regenerated by wails3.

!macro marksafe.mlcdoc
    !ifndef ARG_MLCDOC_DIR
        !error "ARG_MLCDOC_DIR missing: MarkSafe ships mlcdoc (run: task build:windows)"
    !endif
    File "${ARG_MLCDOC_DIR}/mlcdoc.exe"
    SetOutPath "$INSTDIR\licenses\mlcdoc"
    File "${ARG_MLCDOC_DIR}/LICENSE-*"
    File "${ARG_MLCDOC_DIR}/NOTICE-*"
    SetOutPath $INSTDIR
!macroend
