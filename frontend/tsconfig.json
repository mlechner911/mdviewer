{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,

    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    // ../packages/mlcext-editor resolves CodeMirror from this app
    "baseUrl": ".",
    "paths": {
      "@codemirror/*": ["./node_modules/@codemirror/*"],
      "mlc-markdown": ["../packages/mlc-markdown/src/index.ts"],
      // type-checks the module itself; the build picks the variant (vite.config.ts)
      "$sensormonitor": ["./src/sensormonitor/index.ts"],
      "mlc-markdown-svelte": ["../packages/mlc-markdown-svelte/src/index.d.ts"],
      "marked": ["./node_modules/marked"],
      "dompurify": ["./node_modules/dompurify"],
      "marked-footnote": ["./node_modules/marked-footnote"]
    }
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "../packages/mlcext-editor/src/**/*.ts",
    "../packages/mlc-markdown/src/**/*.ts",
    "../packages/mlc-markdown-svelte/src/**/*.svelte"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
