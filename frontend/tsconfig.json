{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,

    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    // ../packages/mlcext-editor resolves CodeMirror from this app
    "baseUrl": ".",
    "paths": {
      "@codemirror/*": ["./node_modules/@codemirror/*"]
    }
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "../packages/mlcext-editor/src/**/*.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
