{
  "$schema": "https://raw.githubusercontent.com/mlechner911/mdviewer/main/mlcext/mlc-template.schema.json",
  "name": "CHANGELOG",
  "description": "Änderungsprotokoll nach „Keep a Changelog“ mit Semantic Versioning.",
  "category": "general",
