{
  "$schema": "https://raw.githubusercontent.com/mlechner911/mdviewer/main/mlcext/mlc-template.schema.json",
  "name": "Information (INFO)",
  "description": "Kurzes Informationsblatt.",
  "category": "mlc",
  "body": "info.md",
  "file": "{{doc_id}}.md",
  "fields": [
    {
      "id": "title",
      "label": "Titel",
      "type": "text",
      "required": true,
      "target": "frontmatter",
      "placeholder": "Lagerung kühlkettenpflichtiger Arzneimittel"
    },
    {
      "id": "bereich",
      "label": "Bereich",
      "type": "text",
      "default": "QM",
      "help": "Kürzel in der Kennung, z. B. QM, KAL, LAG"
    },
    {
      "id": "doc_id",
      "label": "Dokumenten-ID",
      "type": "refno",
      "prefix": "INFO",
      "area": "bereich",
      "required": true,
      "target": "frontmatter",
      "help": "Vorschlag aus dem Dokumentenordner; ob sie frei ist, prüft der Sensor Monitor beim Hochladen."
    },
    {
      "id": "version",
      "label": "Version",
      "type": "text",
      "default": "1.0",
      "required": true,
      "target": "frontmatter"
    },
    {
      "id": "description",
      "label": "Beschreibung",
      "type": "text",
      "target": "frontmatter",
      "help": "Ein Satz für die Dokumentenliste; optional."
    }
  ]
}
